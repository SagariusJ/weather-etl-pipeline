# Copia este archivo a .env y completa los valores.
# Generar claves:  python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_FERNET_KEY=<clave-generada>
AIRFLOW_JWT_SECRET=<clave-generada>

# Warehouse (accesible desde tu PC en localhost:WAREHOUSE_PORT)
WAREHOUSE_USER=weather
WAREHOUSE_PASSWORD=<elige-una-password-alfanumerica>
WAREHOUSE_DB=weather
WAREHOUSE_PORT=15432

# Base separada para los tests de integracion (se borra en cada test; debe terminar en _test)
TEST_WAREHOUSE_DB=weather_test
